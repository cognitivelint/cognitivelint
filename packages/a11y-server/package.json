{
  "name": "@cognitivelint/a11y-server",
  "version": "0.1.0",
  "description": "Language server for CognitiveLint Accessibility Agent",
  "author": "Deepak Koul",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cognitivelint/cognitivelint.git",
    "directory": "packages/a11y-server"
  },
  "type": "module",
  "bin": {
    "cognitivelint-a11y-server": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@cognitivelint/a11y": "workspace:*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "keywords": ["cognitivelint", "accessibility", "lsp", "language-server"]
}
