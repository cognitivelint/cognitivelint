{
  "name": "cognitivelint-a11y",
  "displayName": "CognitiveLint Accessibility Agent",
  "description": "Accessibility guidance for React — jsx-a11y + Screen Reader, Keyboard, and Cognitive subagents using your editor's built-in AI",
  "version": "0.1.0",
  "publisher": "cognitivelint",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cognitivelint/cognitivelint.git",
    "directory": "packages/vscode-a11y"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "accessibility",
    "a11y",
    "react",
    "jsx-a11y",
    "cognitivelint",
    "chat-participant"
  ],
  "activationEvents": [
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onChatParticipant:cognitivelint.screenReader",
    "onChatParticipant:cognitivelint.keyboard",
    "onChatParticipant:cognitivelint.cognitive"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cognitivelint.a11y.fix",
        "title": "CognitiveLint: Fix"
      },
      {
        "command": "cognitivelint.a11y.why",
        "title": "CognitiveLint: Why?"
      },
      {
        "command": "cognitivelint.a11y.rescan",
        "title": "CognitiveLint: Rescan Accessibility"
      }
    ],
    "chatParticipants": [
      {
        "id": "cognitivelint.screenReader",
        "fullName": "Screen Reader Agent",
        "name": "screen-reader",
        "description": "Explain how JSX affects screen-reader users and how to fix it",
        "isSticky": true
      },
      {
        "id": "cognitivelint.keyboard",
        "fullName": "Keyboard Agent",
        "name": "keyboard",
        "description": "Explain keyboard accessibility issues and remediations",
        "isSticky": true
      },
      {
        "id": "cognitivelint.cognitive",
        "fullName": "Cognitive Agent",
        "name": "cognitive",
        "description": "Explain cognitive accessibility burden and clearer labeling",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "CognitiveLint Accessibility",
      "properties": {
        "cognitivelint.a11y.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable CognitiveLint Accessibility Agent diagnostics"
        },
        "cognitivelint.a11y.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces communication between VS Code and the language server"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "cognitivelint.a11y.fix",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact"
        },
        {
          "command": "cognitivelint.a11y.why",
          "when": "editorLangId == typescriptreact || editorLangId == javascriptreact"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "dev": "tsc -p ./ --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "package": "pnpm build && echo 'Extension built to dist/'"
  },
  "dependencies": {
    "@cognitivelint/a11y-server": "workspace:*",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0"
  }
}
